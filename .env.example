# Discord bot token
DISCORD_TOKEN=token

# Channel IDs for the honeypot and admin channels
HONEYPOT_CHANNEL_ID=123456789012345678
ADMIN_CHANNEL_ID=123456789012345678

# Members and roles that are whitelisted (comma-separated)
WHITELIST_USER_IDS=111111111111111111,222222222222222222
WHITELIST_ROLE_IDS=333333333333333333

# Time in seconds to keep the history of detected bots before deletion
DELETE_HISTORY_SECONDS=3600

# Enable or disable automatic warnings for detected bots
AUTO_WARNING=true

# Enable or disable automatic banning for detected bots
ROFILING=true

# Raid protection settings
RAID_JOINS=5
RAID_WINDOW=60

# Update check settings
UPDATE_CHECK=true
UPDATE_CHECK_HOURS=6
